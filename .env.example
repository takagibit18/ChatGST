# Model. MODEL_NAME is deliberately required for a real DeepSeek run.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=
MODEL_TEMPERATURE=0.1
MODEL_MAX_OUTPUT_TOKENS=1200
MODEL_TIMEOUT_MS=30000

# Observability is opt-in and content capture is off by default.
RAINDROP_ENABLED=false
RAINDROP_WRITE_KEY=
RAINDROP_PROJECT_ID=
RAINDROP_CAPTURE_CONTENT=false

# Ontology platform and rule engine. Leave blank to keep the runtime on local RAG only.
ONTO_PLATFORM_URL=
ONTO_PLATFORM_USERNAME=
ONTO_PLATFORM_PASSWORD=
RULE_ENGINE_URL=
RULE_ENGINE_USERNAME=
RULE_ENGINE_PASSWORD=
RULE_ENGINE_POLICY_ID=
POLICY_RULE_ENGINE_TOOL_ENABLED=true
POLICY_WORKSPACES_ROOT=
STEP2_DATA_ROOT=knowledge/raw
STEP2_MERGE_CONFLICT_ACTION=use_candidate

# Runtime safety budgets.
MAX_AGENT_STEPS=6
MAX_MODEL_CALLS=2
MAX_TOOL_CALLS=4
MAX_INPUT_LENGTH=2000
MAX_INPUT_TOKENS=1200
MAX_OUTPUT_TOKENS=1400
REQUEST_TIMEOUT_MS=45000
MAX_CONCURRENT_RUNS=4
MAX_QUEUE_SIZE=16
SESSION_IDLE_TTL=600000
RETRIEVAL_TOP_K=5

# Local-only server. HOST is validated and may only be loopback.
HOST=127.0.0.1
PORT=3001
MODEL_PROVIDER=test
LOG_LEVEL=info
